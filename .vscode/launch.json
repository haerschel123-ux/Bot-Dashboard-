{
  // VS-Code-Startkonfigurationen. Auswählen im „Run and Debug"-Panel (Strg+Shift+D),
  // dann F5 drücken.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bot + Dashboard (voll – steuert den echten Bot)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bot.py",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Nur Dashboard (UI-Vorschau, ohne Discord)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bot.py",
      "args": ["--dashboard-only"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PORT": "8080"
      }
    }
  ]
}
